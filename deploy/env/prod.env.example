# face-py prod mode.
#
# 跟 dev 不同点:
# - PORT 32192 (dev 33293)
# - HOST 0.0.0.0 (对外, 但本机部署里仍只跟 TA 走 loopback, 没必要对外 — 看你选)
# - AUTH_TOKEN 必填 → AUTH_REQUIRED=true
# - LOG_LEVEL=INFO
#
# 用法:
#   cp prod.env.example ../prod.env   # 拷模板
#   $EDITOR ../prod.env               # 填 AUTH_TOKEN
#   sudo docker compose up -d face-py-prod

FACE_HTTP_HOST=127.0.0.1
FACE_HTTP_PORT=32192
FACE_LOG_LEVEL=INFO

# ---- Auth (跟 face C++ 同协议: Bearer / X-API-Key) ----
# **必填**. 跟 TA 端 FACE_HTTP_AUTH_TOKEN 同值. 拿一段足够随机的:
#   openssl rand -hex 32
FACE_HTTP_AUTH_TOKEN=
FACE_HTTP_AUTH_REQUIRED=1

# ---- 推理设备 ----
FACE_DEVICE=cuda

# ---- 模型路径 (容器内 /app/models/, Dockerfile 默认已设, 这里 override 也行) ----
FACE_DETECT_MODEL_PATH=/app/models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZE_MODEL_PATH=/app/models/face_recognition_sface_2021dec.onnx

# ---- Optional identity domain adapter (default off; artifact is a read-only host mount) ----
FACE_DOMAIN_ADAPTER_MODE=off

# ---- 业务阈值 (Phase A.5 / A.7, 默认通常不用改) ----
FACE_COSINE_MISMATCH_THRESH=0.15
FACE_COSINE_THRESH=0.30
FACE_L2_THRESH=1.15

# ---- Quality gates ----
FACE_DET_SCORE_MIN=0.88
FACE_BBOX_MIN_PX=40
FACE_CROP_CLARITY_MIN=30

# ---- Pose gate ----
FACE_POSE_ABS_YAW=0.35
FACE_POSE_ABS_PITCH=0.55

# ---- Phase A.7 session_check Stage 1 outlier 阈值 ----
FACE_SESSION_OUTLIER_MEAN_COS=0.20
