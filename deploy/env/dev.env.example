# face-py dev mode.
#
# 跟 prod 不同点:
# - HOST 绑 127.0.0.1, 不对外
# - AUTH_TOKEN 留空 → AUTH_REQUIRED 自动 false
# - DEVICE 默认 cuda; 没 GPU 自动 fallback cpu (CUDAExecutionProvider not available)
# - LOG_LEVEL=DEBUG
#
# 用法 (任选其一):
#   ./run_http_server.sh --env dev
#   set -a; source deploy/env/dev.env.example; set +a; ./run_http_server.sh

FACE_HTTP_HOST=127.0.0.1
FACE_HTTP_PORT=32192
FACE_LOG_LEVEL=DEBUG

# ---- 推理设备 ----
FACE_DEVICE=cuda

# ---- 模型路径 (gitignored, 用前 cp from jiapei-anticheat/models/) ----
FACE_DETECT_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx

# ---- 业务阈值 ----
# face-py 默认跟 face C++ **不同**: SFace 跟 face-reid-retail-0095 cos 分布偏移
# ~ -0.10. v0.4.0 重 tune 默认是 cos=0.30 / l2=1.10 (docs/cross_validation_v0_4_0.md).
# 切到 face-py 时 TA 端 FACE_COSINE_THRESH env **必须同步切**, 否则带 face C++ 的 0.4
# 阈值打 face-py 会得到 55% 决策一致率灾难.
FACE_COSINE_THRESH=0.30
FACE_L2_THRESH=1.10
FACE_COSINE_INCONCLUSIVE_THRESH=0.20    # face#13 中间区, 默认按 cos 阈值 - 0.1 给

# ---- pose gate (跟 face C++ #13 patch 后同款默认) ----
FACE_POSE_ABS_YAW=0.35
FACE_POSE_ABS_PITCH=0.55
