# face-py dev mode.
#
# 跟 prod 不同点:
# - PORT 33293 (prod 32192)
# - HOST 绑 127.0.0.1, 不对外
# - AUTH_TOKEN 留空 → AUTH_REQUIRED 自动 false
# - DEVICE 默认 cuda; 没 GPU 自动 fallback cpu (CUDAExecutionProvider not available)
# - LOG_LEVEL=DEBUG
#
# 用法:
#   sudo docker compose up -d face-py-dev          # docker (推荐)
#   ./run_http_server.sh --env dev                 # 裸机
#   set -a; source deploy/env/dev.env.example; set +a; ./run_http_server.sh

FACE_HTTP_HOST=127.0.0.1
FACE_HTTP_PORT=33293
FACE_LOG_LEVEL=DEBUG

# ---- 推理设备 ----
FACE_DEVICE=cuda

# ---- 模型路径 (docker 容器内是 /app/models/, 裸机是 ./models/) ----
# Dockerfile 里已设容器内默认值, 这里给裸机模式一个相对路径覆盖
FACE_DETECT_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx

# ---- Optional identity domain adapter (default off; artifact is a read-only host mount) ----
FACE_DOMAIN_ADAPTER_MODE=off
FACE_DOMAIN_ADAPTER_PATH=/models/identity-domain-adapter/identity_domain_adapter.onnx

# ---- 业务阈值 (Phase A.5 quality gates + cos 中间区) ----
#
# face-py 决策三态: cos < 0.15 → mismatch, cos ≥ 0.30 AND l2 ≤ 1.15 → match,
# 其余 → inconclusive. 中间区刻意保留, "拿不准就说拿不准", 比错报代训好.
#
# 切到 face-py 时 TA 端**不需要**改 FACE_COSINE_THRESH — TA 只看 has_identity_anomaly,
# 由 face-py 的 match_status="mismatch" 触发. 但**这些 env 跟 face C++ 不通用**, 部署
# 时按 face-py 默认即可, face C++ 部署仍用 0.4/1.0.
FACE_COSINE_MISMATCH_THRESH=0.15    # cos 低于此 → mismatch (高置信不像)
FACE_COSINE_THRESH=0.30              # cos 高于此 AND l2 OK → match
FACE_L2_THRESH=1.15                  # match 要求的 l2 上限

# ---- Quality gates (Phase A.5) ----
# 任一不过 → match_status="inconclusive", error_code 标具体原因. 见 module/face/quality_gate.py.
FACE_DET_SCORE_MIN=0.88              # YuNet 检测自信度. < 此值认为检测不可信
FACE_BBOX_MIN_PX=40                  # 源 bbox min(w,h) < 此值认为 face 太小 (SFace 输入不稳)
FACE_CROP_CLARITY_MIN=30             # aligned 112×112 crop Laplacian variance, 反映清晰度

# ---- pose gate ----
FACE_POSE_ABS_YAW=0.35
FACE_POSE_ABS_PITCH=0.55
