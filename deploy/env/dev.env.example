# face-py dev mode.
#
# 跟 prod 不同点:
# - HOST 绑 127.0.0.1, 不对外
# - AUTH_TOKEN 留空 → AUTH_REQUIRED 自动 false
# - DEVICE 默认 cuda; 没 GPU 自动 fallback cpu (CUDAExecutionProvider not available)
# - LOG_LEVEL=DEBUG
#
# 用法 (任选其一):
#   ./run_http_server.sh --env dev
#   set -a; source deploy/env/dev.env.example; set +a; ./run_http_server.sh

FACE_HTTP_HOST=127.0.0.1
FACE_HTTP_PORT=32192
FACE_LOG_LEVEL=DEBUG

# ---- 推理设备 ----
FACE_DEVICE=cuda

# ---- 模型路径 (gitignored, 用前 cp from jiapei-anticheat/models/) ----
FACE_DETECT_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx

# ---- 业务阈值 (跟 face C++ + TA 同名同默认, 别 rename) ----
FACE_COSINE_THRESH=0.4
FACE_COSINE_INCONCLUSIVE_THRESH=0.3
